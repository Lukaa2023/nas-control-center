[Unit]
Description=NAS Control Center network status snapshot
After=network-online.target NetworkManager.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=vuky
Group=vuky
ExecStart=/usr/bin/python3 /usr/local/bin/nas-network-monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/nas/websites/vukyweb/nas/data
